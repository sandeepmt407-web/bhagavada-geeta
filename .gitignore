# Unity generated
Gita3D/Library/
Gita3D/Temp/
Gita3D/Obj/
Gita3D/Logs/
Gita3D/UserSettings/
Gita3D/*.csproj
Gita3D/*.sln

# build outputs and tooling downloads
build/
android-sdk/
avd/
_tools/obj/
_tools/bin/

# signing material must never be committed
keystore/

# archived release binaries (kept on disk, not in history)
releases/**/*.apk
releases/**/*.aab

# IL2CPP build temp - object files and ninja state, regenerated every build
Gita3D/.utmp/

# portable toolchain downloaded for the Firebase deploy, not part of the project
_tools/node/
_tools/npm-global/

# generated by Unity's performance testing package on each build
Gita3D/Assets/Resources/PerformanceTestRun*.json
Gita3D/Assets/Resources/PerformanceTestRun*.json.meta

# firebase deploy cache
playstore-requirements/legal/.firebase/
